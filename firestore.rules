rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Maintained through the project console. This collection contains only public work-site locations.
    match /worksites/{siteId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
