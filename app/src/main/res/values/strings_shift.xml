    <!-- A stop the walk passed in an hour that has since cooled: Today shows the break as due, and it stays due. -->
    <string name="break_cant_stop_hint_due">Nothing is added to your breaks. Your break is still due.</string>
    <!-- Answered early: the break is due later than the 10-minute snooze, so it keeps its own time. %1$s that time. -->
    <string name="break_cant_stop_hint_later">Nothing is added to your breaks. Your next break is due at %1$s.</string>
