    <!-- Auto-end (ShiftRepository.autoEndIfOverdue): the saved end is the planned finish, or the last break or answer
         logged after it, and the shift is closed 2 hours after that saved end.
         Example: planned finish 15:00, nothing after it → closed at 17:00, saved as ending 15:00. With a break
         15:40–15:55 → closed at 17:55, saved as ending 15:55. -->
    <string name="shift_finish_supporting">If the shift is still running 2 hours after its planned finish, HeatShield ends it and saves the planned finish as its end. A break or answer logged after the planned finish counts instead: it is saved as the end, and the 2 hours count from it.</string>
    <string name="shift_error_start_future">The start can\'t be later than now.</string>
    <string name="shift_error_finish">Finish must be after the start and within 16 hours.</string>

    <!-- Today, on shift. The since clause: %1$s is a duration ("47 min", "1 h 12 min"). -->
    <string name="shift_since_break">%1$s since your break</string>
    <string name="shift_since_start">%1$s since you started</string>
