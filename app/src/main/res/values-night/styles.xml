<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark variant of values/styles.xml: dark framework parent and light status-bar icons. -->
    <style name="Theme.HeatShield" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/paper_window</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/action_window</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
